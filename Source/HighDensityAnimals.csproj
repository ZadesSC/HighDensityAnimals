<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>0.2.0</Version>
    <AssemblyName>HighDensityAnimals</AssemblyName>
    <OutputPath>../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <GameManagedPath Condition="'$(GameManagedPath)' == '' and Exists('$(RimWorldDir)/RimWorld.app/Contents/MacOS/Assembly-CSharp.dll')">$(RimWorldDir)/RimWorld.app/Contents/MacOS</GameManagedPath>
    <GameManagedPath Condition="'$(GameManagedPath)' == '' and Exists('$(RimWorldDir)/RimWorldMac.app/Contents/Resources/Data/Managed/Assembly-CSharp.dll')">$(RimWorldDir)/RimWorldMac.app/Contents/Resources/Data/Managed</GameManagedPath>
    <GameManagedPath Condition="'$(GameManagedPath)' == '' and Exists('$(RimWorldDir)/RimWorldWin64_Data/Managed/Assembly-CSharp.dll')">$(RimWorldDir)/RimWorldWin64_Data/Managed</GameManagedPath>
    <GameManagedPath Condition="'$(GameManagedPath)' == '' and Exists('$(RimWorldDir)/RimWorldLinux_Data/Managed/Assembly-CSharp.dll')">$(RimWorldDir)/RimWorldLinux_Data/Managed</GameManagedPath>
  </PropertyGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedPath)/Assembly-CSharp.dll')" Text="Set RimWorldDir or GameManagedPath to the matching RimWorld 1.7 installation." />
    <Error Condition="!Exists('$(HarmonyAssembly)')" Text="Set HarmonyAssembly to the matching Harmony 0Harmony.dll." />
  </Target>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedPath)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyAssembly)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UnityStubs"><HintPath>$(GameManagedPath)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(GameManagedPath)/Waylith.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
