<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HDA_AnimalDensifier</defName>
    <label>animal densifier</label>
    <description>An automated bioprocessing machine that ropes in colony animals two at a time, liquefies nutrient feedstock, and compresses the animals into denser livestock.</description>
    <thingClass>HighDensityAnimals.Building_AnimalDensifier</thingClass>
    <tickerType>Rare</tickerType>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Ship/ShipCryptosleepCasket</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,2)</drawSize>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <defaultPlacingRot>East</defaultPlacingRot>
    <size>(1,2)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <blockWind>true</blockWind>
    <useHitPoints>true</useHitPoints>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>7000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <Steel>160</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites><li>Electricity</li></researchPrerequisites>
    <designationCategory>Production</designationCategory>
    <uiOrder>2135</uiOrder>
    <surfaceType>Item</surfaceType>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <inspectorTabs>
      <li>HighDensityAnimals.ITab_DensifierStorage</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>250</basePowerConsumption>
        <idlePowerDraw>50</idlePowerDraw>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
    <building>
      <isEdifice>true</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
      <haulToContainerDuration>120</haulToContainerDuration>
      <uninstallWork>1200</uninstallWork>
      <workTableRoomRole>Laboratory</workTableRoomRole>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>Foods</li>
          </categories>
          <specialFiltersToDisallow>
            <li>AllowPlantFood</li>
          </specialFiltersToDisallow>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <filter>
          <categories>
            <li>Foods</li>
          </categories>
          <disallowedCategories>
            <li>EggsFertilized</li>
          </disallowedCategories>
          <disallowedThingDefs>
            <li>InsectJelly</li>
            <li>MealLavish</li>
            <li>MealLavish_Veg</li>
            <li>MealLavish_Meat</li>
            <li>Chocolate</li>
          </disallowedThingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
  </ThingDef>
</Defs>
